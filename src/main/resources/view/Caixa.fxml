<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdv.controller.CaixaController" stylesheets="@estilo.css">
    
    <Label text="Gestão de Caixa e Turno" styleClass="titulo-tela"/>

    <!-- Status do Caixa -->
    <HBox alignment="CENTER" styleClass="card" style="-fx-padding: 20;">
        <Label fx:id="lblStatusCaixa" text="VERIFICANDO STATUS..." style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        
        <!-- PAINEL DE ABERTURA -->
        <VBox fx:id="boxAbrirCaixa" spacing="15.0" styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Abertura de Turno" styleClass="subtitulo" style="-fx-font-size: 20px;"/>
            <Label text="Informe o valor de troco inicial que está na gaveta." style="-fx-text-fill: #8e8e9e;"/>
            
            <VBox spacing="5.0" maxWidth="300.0" alignment="CENTER_LEFT">
                <Label text="Troco Inicial (Fundo de Caixa - R$)"/>
                <TextField fx:id="txtValorAbertura" promptText="Ex: 50,00" style="-fx-font-size: 18px;"/>
            </VBox>
            
            <Button text="🔑 ABRIR CAIXA" onAction="#abrirCaixa" styleClass="btn-sucesso" prefWidth="300.0" prefHeight="50.0" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        </VBox>

        <!-- PAINEL DE OPERAÇÃO COM SCROLLPANE CORRETO -->
        <ScrollPane fx:id="boxOperacaoCaixa" fitToWidth="true" HBox.hgrow="ALWAYS" managed="false" visible="false" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <VBox spacing="15.0">
                
                <VBox spacing="15.0" styleClass="card">
                    <Label text="Lançar Sangria ou Suprimento" styleClass="subtitulo"/>
                    <Label text="Sangria (Retirada de Dinheiro) | Suprimento (Entrada de Troco Adicional)" style="-fx-text-fill: #8e8e9e;"/>
                    
                    <HBox spacing="10.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Tipo de Movimento"/>
                            <ComboBox fx:id="cbTipoMovimento" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5.0" prefWidth="150.0">
                            <Label text="Valor (R$)"/>
                            <TextField fx:id="txtValorMovimento" promptText="0,00"/>
                        </VBox>
                    </HBox>
                    
                    <VBox spacing="5.0">
                        <Label text="Motivo / Observação"/>
                        <TextField fx:id="txtMotivoMovimento" promptText="Ex: Pagamento de Fornecedor, Compra de Água, Reforço de Troco..."/>
                    </VBox>
                    
                    <Button text="Registrar Movimentação" onAction="#registrarMovimento" styleClass="btn-neutro" maxWidth="Infinity"/>
                </VBox>
                
                <VBox spacing="15.0" styleClass="card">
                    <Label text="Resumo do Turno Atual" styleClass="subtitulo"/>
                    
                    <Label fx:id="lblResumo" text="Vendas Dinheiro: R$ 0,00 | Suprimentos: R$ 0,00 | Sangrias: R$ 0,00" style="-fx-font-size: 14px; -fx-text-fill: #8e8e9e;"/>
                    <Label fx:id="lblTotalGaveta" text="Valor Esperado na Gaveta: R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                    
                    <Separator styleClass="separador"/>
                    
                    <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Valor real contado na gaveta agora (R$):" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtValorFechamento" promptText="0,00" style="-fx-font-size: 16px;"/>
                        </VBox>
                        <Button text="🔒 FECHAR CAIXA" onAction="#fecharCaixa" styleClass="btn-perigo" prefHeight="45.0" prefWidth="200.0" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    </HBox>
                </VBox>
                
            </VBox>
        </ScrollPane>
        
    </HBox>
    <Label fx:id="lblMensagem" wrapText="true" alignment="CENTER" maxWidth="Infinity"/>
</VBox>